# Copy this file to .env.local and fill in real values.
# .env.local is ignored by git, so secrets and account ids stay out of source control.

# Google Analytics measurement id, e.g. G-XXXXXXXXXX.
# Leave empty (or delete the line) to build without any analytics tag.
GA_MEASUREMENT_ID=

# Destination directory used by "npm run deploy".
# Defaults to E:\xampp\htdocs\rpg5 when unset.
DEPLOY_TARGET=
